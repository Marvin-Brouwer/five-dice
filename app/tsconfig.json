{
	"$schema": "https://json.schemastore.org/tsconfig",
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["vite/client"]
	},
	"include": [
		"src/**/*.mts",
		"src/**/*.ts",
		"src/_routes.g.mts",
		"tests/**/*.mts",
		"e2e/**/*.mts",
		"tests/**/*.ts",
		"plugins/**/*.mts"
	]
}
