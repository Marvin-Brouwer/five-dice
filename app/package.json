{
	"name": "@five-dice/app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"homepage": "https://marvin-brouwer.github.io/five-dice/",
	"repository": {
		"type": "git",
		"url": "https://github.com/Marvin-Brouwer/five-dice"
	},
	"license": "Apache-2.0",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
		"generate:textures": "node scripts/textures/generate.mts",
		"generate:textures:paper": "node scripts/textures/generate.mts --kind paper",
		"generate:textures:noise": "node scripts/textures/generate.mts --kind noise",
		"test:e2e": "playwright test",
		"test:e2e:install": "playwright install chromium",
		"test:e2e:ui": "playwright test --ui-port=0",
		"test:e2e:report": "playwright show-report"
	},
	"dependencies": {
		"@rooted/components": "1.0.0-alpha.19",
		"@rooted/elements": "1.0.0-alpha.11",
		"@rooted/events": "1.0.0-alpha.11",
		"@rooted/localization": "1.0.0-alpha.12",
		"@rooted/markdown": "1.0.0-alpha.7",
		"@rooted/router": "1.0.0-alpha.23",
		"@rooted/storage": "1.0.0-alpha.7",
		"@rooted/store": "1.0.0-alpha.6",
		"@rooted/util": "1.0.0-alpha.9",
		"js-confetti": "^0.11.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@rooted-adapters/github-pages": "1.0.0-alpha.16",
		"@rooted/adapter": "1.0.0-alpha.16",
		"@rooted/application": "1.0.0-alpha.28",
		"@rooted/seo": "1.0.0-alpha.10",
		"@types/node": "^20.0.0",
		"happy-dom": "^20.14.0",
		"iterative-permutation": "^1.0.0",
		"typescript": "^5.4.0",
		"vite": "^8.0.16",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^1.6.0"
	}
}
