{
  "name": "five-dice",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @five-dice/app-rooted dev",
    "build": "pnpm --filter @five-dice/app-rooted build",
    "preview": "pnpm --filter @five-dice/app-rooted preview",
    "test": "pnpm --filter @five-dice/app-rooted test",
    "test:e2e": "pnpm --filter @five-dice/app-rooted test:e2e",
    "lint": "pnpm --filter @five-dice/app-rooted lint",
    "test:all": "pnpm -r test",
    "dev:legacy": "pnpm --filter @five-dice/app dev",
    "build:legacy": "pnpm --filter @five-dice/app build",
    "test:legacy": "pnpm --filter @five-dice/app test",
    "lint:legacy": "pnpm --filter @five-dice/app lint"
  },
  "devDependencies": {
    "astro": "^2.3.0"
  },
  "pnpm": {
    "overrides": {
      "undici@<5.19.1": ">=5.19.1",
      "undici@>=2.0.0 <5.19.1": ">=5.19.1"
    },
    "onlyBuiltDependencies": [
      "@jasikpark/astro-svg-loader",
      "esbuild",
      "sharp"
    ]
  },
  "volta": {
    "node": "20.9.0"
  }
}
